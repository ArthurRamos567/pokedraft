# Copy to .env and fill in. Only the first block is required to boot.
#   cp .env.example .env
#   openssl rand -base64 32     # -> BETTER_AUTH_SECRET

# ── required ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Port 5442, not 5432 — the default is left to any
# postgres already installed on the host.
DATABASE_URL=postgres://pokedraft:pokedraft@localhost:5442/pokedraft
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# ── optional ────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=debug
NODE_ENV=development

# Integration tests. Start with: docker compose --profile test up -d
TEST_DATABASE_URL=postgres://pokedraft:pokedraft@localhost:5443/pokedraft_test

# ── oauth (optional, dev only) ──────────────────────────────────────────────
# Leave blank to skip. Each provider registers only when both of its vars are
# set, so email/password works out of the box with none of this filled in.
#
# Discord:  https://discord.com/developers/applications -> OAuth2
#           redirect: http://localhost:3000/api/auth/callback/discord
# Google:   https://console.cloud.google.com/apis/credentials
#           redirect: http://localhost:3000/api/auth/callback/google
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── frontend ────────────────────────────────────────────────────────────────
# Vite/TanStack Start defaults to 3000, which the API owns — vite.config.ts
# reads WEB_PORT and must never fall back to 3000.
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
