{
  "name": "pokedraft",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test apps packages",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:studio": "drizzle-kit studio --config packages/db/drizzle.config.ts",
    "seed": "bun run apps/api/src/scripts/seed-demo.ts",
    "verify": "./scripts/verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
